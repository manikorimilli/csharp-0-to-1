<!-- Sdk.Web adds ASP.NET Core: Kestrel web server, controllers, configuration, logging. -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The Api is the "composition root": it references every layer and wires them together. -->
  <ItemGroup>
    <ProjectReference Include="..\RealWorldSample.Core\RealWorldSample.Core.csproj" />
    <ProjectReference Include="..\RealWorldSample.Infrastructure\RealWorldSample.Infrastructure.csproj" />
  </ItemGroup>

</Project>
